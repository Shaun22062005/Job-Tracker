# ==============================================================================
# Job Tracker - Local Docker Environment Variables
# ==============================================================================
# Copy this file to .env before starting containers:
#   cp .env.example .env (or 'Copy-Item .env.example .env' in PowerShell)
# ==============================================================================

# Backend Security & JWT
SECRET_KEY=local-docker-dev-secret-key-minimum-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# Database Configuration (Docker Compose internal network)
# Note: Host connection to database uses 127.0.0.1:5433
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/jobtracker

# Local PostgreSQL Container Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobtracker

# Google OAuth Credentials
# Note: Google Sign-In requires the origin 'http://localhost:4200' to be in
# Authorized JavaScript Origins in your Google Cloud Console project.
GOOGLE_CLIENT_ID=1000078445400-bdoqo73uebsu5bfqbm0tdhelqncdvg4p.apps.googleusercontent.com

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:4200
